# Clickyy AI — environment overrides (all optional). Placeholders only; never commit real values.
# API keys are NOT read from the environment; enter them in Settings > Credentials (stored with Windows DPAPI).

# Where to find the Python speech service (folder containing clickyy_speech/ and .venv/)
CLICKYY_SPEECH_DIR=
# Python interpreter for the speech service (defaults to <CLICKYY_SPEECH_DIR>\.venv\Scripts\python.exe)
CLICKYY_PYTHON=
# Vosk model directory (defaults to <CLICKYY_SPEECH_DIR>\models\vosk-model-small-en-us-0.15)
CLICKYY_VOSK_MODEL=
# Use a separate profile folder (used by automated tests)
CLICKYY_USER_DATA=
